{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoyo-x402-minicurator",
  "main": "src/curator-worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "secrets": { "required": [] },
  "vars": { "SELLER_ADDRESS": "0x303782B1b788527bE6cC28C6F16aA2A3Ba26b59f" },
  "ratelimits": [{ "name": "UPSTREAM_RATE_LIMITER", "namespace_id": "4022026", "simple": { "limit": 20, "period": 10 } }]
}
